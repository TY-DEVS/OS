# Macro OS Coolify Environment Configuration
# These are default values for self-hosting on Coolify.
# In Coolify, you can add or override these in the Application -> Environment Variables tab.

# Domain & Ingress
DOMAIN=macro.ty-dev.site
COOLIFY_APP_NAME="Macro OS"

# Secrets (Change in production!)
INTERNAL_API_SECRET_KEY=local-development-internal-secret-key-32chars
DOCUMENT_PERMISSION_JWT=local-development-doc-permission-jwt-key
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=local-development-dss-auth-key

# Database (External PostgreSQL)
# Option A - Coolify-managed Standalone PostgreSQL (internal container network):
# DATABASE_URL=postgres://postgres:<password>@<database_uuid>:5432/postgres
# Example with existing Infrastructure PostgreSQL (pgg8c00gw00o0gk0kc0g84sc):
# DATABASE_URL=postgres://postgres:YOMFBjzOHTAZtfogMLYGOvp3jJTBUW7zXIQH7HFHPWC4uzW4muObmDgoNXMhZtOM@pgg8c00gw00o0gk0kc0g84sc:5432/postgres
# DATABASE_URL_READONLY=postgres://postgres:YOMFBjzOHTAZtfogMLYGOvp3jJTBUW7zXIQH7HFHPWC4uzW4muObmDgoNXMhZtOM@pgg8c00gw00o0gk0kc0g84sc:5432/postgres
#
# Option B - External Cloud / Remote PostgreSQL (RDS, Supabase, Neon):
# DATABASE_URL=postgres://<user>:<password>@<db-host>:5432/<dbname>?sslmode=require
# DATABASE_URL_READONLY=postgres://<user>:<password>@<db-host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgres://postgres:YOMFBjzOHTAZtfogMLYGOvp3jJTBUW7zXIQH7HFHPWC4uzW4muObmDgoNXMhZtOM@pgg8c00gw00o0gk0kc0g84sc:5432/postgres
DATABASE_URL_READONLY=postgres://postgres:YOMFBjzOHTAZtfogMLYGOvp3jJTBUW7zXIQH7HFHPWC4uzW4muObmDgoNXMhZtOM@pgg8c00gw00o0gk0kc0g84sc:5432/postgres

# Redis
REDIS_URI=redis://redis:6379
DOCUMENT_STORAGE_SERVICE_REDIS_URI=redis://redis:6379

# FusionAuth
FUSIONAUTH_URL=http://fusionauth:9011
FUSIONAUTH_API_KEY=bf69486b-4733-4954-a44e-2e1b5f2c8a91

# Kafka & Search
KAFKA_BROKERS=kafka:29092
OPENSEARCH_URL=http://search:9200

# LocalStack AWS Emulation
LOCAL_AWS_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Optional GitHub Packages token for building packages (if needed)
GITHUB_PACKAGES_TOKEN=
